        <label class="grid gap-2 text-sm font-semibold text-slate-700">Email<input class="rounded-2xl border border-stone-300 bg-stone-50 px-4 py-3 font-normal text-slate-950 outline-none focus:border-brand focus:bg-white focus:ring-2 focus:ring-brand/30" type="email" name="email" required></label>
        <label class="grid gap-2 text-sm font-semibold text-slate-700">Message<textarea class="min-h-40 rounded-2xl border border-stone-300 bg-stone-50 px-4 py-3 font-normal text-slate-950 outline-none focus:border-brand focus:bg-white focus:ring-2 focus:ring-brand/30" name="message" rows="6" required></textarea></label>
